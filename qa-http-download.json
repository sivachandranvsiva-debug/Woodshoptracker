  <!-- MODAL 1: RECORD PURCHASE (வாங்குதல் / கொள்முதல்) -->
  <div class="action-modal-overlay" id="purchaseModalOverlay" aria-hidden="true">
    <div class="action-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalPurchaseTitle">
      <div class="modal-header bg-cyan-soft">
        <div class="modal-title-wrap">
          <h3 class="modal-title" id="modalPurchaseTitle">Record Wood Purchase / கொள்முதல் பதிவு</h3>
          <span class="modal-subtitle">Log incoming timber acquisition from supplier</span>
        </div>
        <button class="modal-close-btn" id="closePurchaseModalBtn">&times;</button>
      </div>
      <form id="purchaseForm" class="modal-form">
        <div class="form-group">
          <label for="purCategory" class="form-label">Wood Category / மர வகை *</label>
          <select id="purCategory" class="form-input" required>
            <!-- Populated from IndexedDB categories -->
          </select>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="purSupplier" class="form-label">Supplier Name / விற்பனையாளர் *</label>
            <input type="text" id="purSupplier" class="form-input" required placeholder="e.g. Salem Timber Auction">
          </div>
          <div class="form-group">
            <label for="purSupplierPhone" class="form-label">Phone / தொலைபேசி</label>
            <input type="tel" id="purSupplierPhone" class="form-input" placeholder="e.g. 9876543210">
          </div>
        </div>

        <!-- Live Volume Calculator for கன அடி -->
        <div class="calc-helper-box">
          <span class="calc-helper-title">📐 Dimension Calculator (Optional) / கன அடி கணக்கீடு</span>
          <div class="calc-row">
            <input type="number" id="purCalcLength" class="calc-input" step="0.1" placeholder="நீளம் (அடி)">
            <input type="number" id="purCalcWidth" class="calc-input" step="0.1" placeholder="அகலம் (அங்குலம்)">
            <input type="number" id="purCalcThickness" class="calc-input" step="0.1" placeholder="தடிமன் (அங்குலம்)">
            <button type="button" class="btn-calc-apply" id="btnApplyPurCalc">Apply / போடு</button>
          </div>
          <span class="calc-note">சூத்திரம்: (நீளம் × அகலம் × தடிமன்) / 12 = கன அடி</span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="purVolume" class="form-label">Quantity / அளவு (கன அடி) *</label>
            <input type="number" id="purVolume" class="form-input" step="0.01" min="0.01" required placeholder="0.00 கன அடி">
          </div>
          <div class="form-group">
            <label for="purRate" class="form-label">Rate / விலை (₹ per கன அடி) *</label>
            <input type="number" id="purRate" class="form-input" step="1" min="1" required placeholder="₹ / கன அடி">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="purExpense" class="form-label">Purchasing Expenses / செலவு (₹)</label>
            <input type="number" id="purExpense" class="form-input" min="0" placeholder="டீசல், ஏற்றுக்கூலி (₹)">
          </div>
          <div class="form-group">
            <label for="purTotal" class="form-label">Total Purchase Amount / மொத்தம் (₹) *</label>
            <input type="number" id="purTotal" class="form-input font-bold" required min="1" placeholder="₹ 0">
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="btnCancelPurchase">Cancel / ரத்து</button>
          <button type="submit" class="btn-submit bg-cyan">Save Purchase / கொள்முதல் சேமி</button>
        </div>
      </form>
    </div>
  </div>

