        <div class="calc-helper-box">
          <span class="calc-helper-title">📐 Dimension Calculator (Optional) / கன அடி கணக்கீடு</span>
          <div class="calc-row">
            <input type="number" id="saleCalcLength" class="calc-input" step="0.1" placeholder="நீளம் (அடி)">
            <input type="number" id="saleCalcWidth" class="calc-input" step="0.1" placeholder="அகலம் (அங்குலம்)">
            <input type="number" id="saleCalcThickness" class="calc-input" step="0.1" placeholder="தடிமன் (அங்குலம்)">
            <button type="button" class="btn-calc-apply" id="btnApplySaleCalc">Apply / போடு</button>
          </div>
          <span class="calc-note">சூத்திரம்: (நீளம் × அகலம் × தடிமன்) / 12 = கன அடி</span>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="saleVolume" class="form-label">Quantity Sold / விற்பனை அளவு (கன அடி) *</label>
            <input type="number" id="saleVolume" class="form-input" step="0.01" min="0.01" required placeholder="0.00 கன அடி">
          </div>
          <div class="form-group">
            <label for="saleRate" class="form-label">Rate / விலை (₹ per கன அடி) *</label>
            <input type="number" id="saleRate" class="form-input" step="1" min="1" required placeholder="₹ / கன அடி">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="saleExpense" class="form-label">Selling Expenses / விற்பனை செலவு (₹)</label>
            <input type="number" id="saleExpense" class="form-input" min="0" placeholder="டெலிவரி, இறக்கு கூலி (₹)">
          </div>
          <div class="form-group">
            <label for="saleTotal" class="form-label">Total Sale Amount / மொத்தம் (₹) *</label>
            <input type="number" id="saleTotal" class="form-input font-bold" required min="1" placeholder="₹ 0">
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="btnCancelSale">Cancel / ரத்து</button>
          <button type="submit" class="btn-submit bg-green">Save Sale / விற்பனை சேமி</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 3: ADD OPERATING EXPENSE (இயக்க செலவுகள்) -->
  <div class="action-modal-overlay" id="expenseModalOverlay" aria-hidden="true">
    <div class="action-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalExpenseTitle">
      <div class="modal-header bg-rose-soft">
        <div class="modal-title-wrap">
          <h3 class="modal-title" id="modalExpenseTitle">Add Operating Expense / செலவு பதிவு</h3>
          <span class="modal-subtitle">Log yard labor, sawmill diesel, electricity, machine repairs</span>
        </div>
        <button class="modal-close-btn" id="closeExpenseModalBtn">&times;</button>
      </div>
      <form id="expenseForm" class="modal-form">
        <div class="form-group">
          <label for="expCategory" class="form-label">Expense Category / செலவு வகை *</label>
          <select id="expCategory" class="form-input" required>
            <option value="Labor Wages">Labor Wages / கூலி சம்பளம்</option>
            <option value="Diesel & Fuel">Diesel & Generator / டீசல் எரிபொருள்</option>
            <option value="Sawmill Electricity">Electricity / மின் கட்டணம்</option>
            <option value="Machine Maintenance">Machine Maintenance / இயந்திர பழுது</option>
            <option value="Transport & Freight">Transport & Freight / போக்குவரத்து</option>
            <option value="Yard Rent">Shop & Yard Rent / வாடகை</option>
            <option value="Miscellaneous">Miscellaneous / இதர செலவு</option>
          </select>
        </div>

        <div class="form-group">
          <label for="expDescription" class="form-label">Description / விவரம் *</label>
          <input type="text" id="expDescription" class="form-input" required placeholder="e.g. 3 Workers daily loading wages">
        </div>

        <div class="form-group">
          <label for="expAmount" class="form-label">Expense Amount / தொகை (₹) *</label>
          <input type="number" id="expAmount" class="form-input font-bold" required min="1" placeholder="₹ 0">
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="btnCancelExpense">Cancel / ரத்து</button>
          <button type="submit" class="btn-submit bg-rose">Save Expense / செலவு சேமி</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 4: ADD OR RENAME WOOD CATEGORY (மர வகை நிர்வாகம்) -->
  <div class="action-modal-overlay" id="categoryModalOverlay" aria-hidden="true">
    <div class="action-modal-card" role="dialog" aria-modal="true" aria-labelledby="modalCategoryTitle">
      <div class="modal-header bg-amber-soft">
        <div class="modal-title-wrap">
          <h3 class="modal-title" id="modalCategoryTitle">Add Wood Category / புதிய மர வகை</h3>
          <span class="modal-subtitle" id="modalCategorySubtitle">Customize timber species for your shop</span>
        </div>
        <button class="modal-close-btn" id="closeCategoryModalBtn">&times;</button>
      </div>
      <form id="categoryForm" class="modal-form">
        <input type="hidden" id="editCategoryId" value="">
        <div class="form-group">
          <label for="catNameInput" class="form-label">Category Name (English) / மர பெயர் (ஆங்கிலம்) *</label>
          <input type="text" id="catNameInput" class="form-input" required placeholder="e.g. Teak Wood, Rosewood, Neem Wood">
        </div>

        <div class="form-group">
          <label for="catNameTaInput" class="form-label">Category Name (Tamil) / மர பெயர் (தமிழ்) *</label>
          <input type="text" id="catNameTaInput" class="form-input" required placeholder="e.g. தேக்கு மரம், ஈட்டி மரம், வேம்பு மரம்">
        </div>

        <div class="form-group">
          <label for="catDescInput" class="form-label">Description / சிறப்புகள்</label>
          <input type="text" id="catDescInput" class="form-input" placeholder="e.g. Grade 1 round logs, sawn lumber">
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="btnCancelCategory">Cancel / ரத்து</button>
          <button type="submit" class="btn-submit bg-amber" id="btnSaveCategory">Save Category / சேமி</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 5: ADD OR EDIT MANUAL INVENTORY STOCK -->
  <div class="action-modal-overlay" id="inventoryModalOverlay" aria-hidden="true">
    <div class="action-modal-card" role="dialog" aria-modal="true" aria-labelledby="inventoryModalTitle">
      <div class="modal-header bg-amber-soft">
        <div class="modal-title-wrap">
          <h3 class="modal-title" id="inventoryModalTitle">Add Inventory Stock / இருப்பு சேர்க்க</h3>
          <span class="modal-subtitle">Manual stock entries are separate from purchase and sale transactions.</span>
        </div>
        <button type="button" class="modal-close-btn" id="closeInventoryModalBtn" aria-label="Close inventory form">&times;</button>
      </div>
      <form id="inventoryForm" class="modal-form">
        <input type="hidden" id="inventoryRecordId" value="">
        <div class="form-group">
          <label for="inventoryCategory" class="form-label">Wood Category / மர வகை *</label>
          <select id="inventoryCategory" class="form-input" required></select>
        </div>

        <div class="form-group">
          <label for="inventoryName" class="form-label">Stock Item Name / இருப்பு பொருள் *</label>
          <input type="text" id="inventoryName" class="form-input" required maxlength="120" placeholder="e.g. Teak logs - Lot A">
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="inventoryQuantity" class="form-label">Piece Quantity *</label>
            <input type="number" id="inventoryQuantity" class="form-input" required min="1" step="1" value="1">
          </div>
          <div class="form-group">
            <label for="inventoryRate" class="form-label">Purchase Rate (₹ / CFT)</label>
            <input type="number" id="inventoryRate" class="form-input" min="0" step="0.01" value="0">
          </div>
        </div>

        <div class="calc-helper-box">
          <span class="calc-helper-title">Dimensions (Optional) / அளவுகள் (விருப்பம்)</span>
          <div class="calc-row">
            <input type="number" id="inventoryLength" class="calc-input" min="0.01" step="0.01" placeholder="Length (feet)">
            <input type="number" id="inventoryWidth" class="calc-input" min="0.01" step="0.01" placeholder="Width (inches)">
            <input type="number" id="inventoryThickness" class="calc-input" min="0.01" step="0.01" placeholder="Thickness (inches)">
            <button type="button" class="btn-calc-apply" id="btnCalculateInventoryCFT">Calculate CFT</button>
          </div>
          <span class="calc-note">CFT = length × width × thickness × pieces ÷ 12</span>
        </div>

        <div class="form-group">
          <label for="inventoryVolume" class="form-label">Total Quantity (CFT) *</label>
          <input type="number" id="inventoryVolume" class="form-input font-bold" required min="0.01" step="0.01" placeholder="e.g. 100">
          <span class="input-helper">Enter CFT directly, or calculate it from all three dimensions and piece quantity.</span>
        </div>

        <div class="form-group">
          <label for="inventoryDescription" class="form-label">Notes / விவரங்கள்</label>
          <input type="text" id="inventoryDescription" class="form-input" maxlength="250" placeholder="Optional grade, location, or other stock details">
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-cancel" id="btnCancelInventory">Cancel / ரத்து</button>
          <button type="submit" class="btn-submit bg-amber" id="btnSaveInventory">Save Stock / இருப்பை சேமி</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Notification Toast Hub -->
  <div class="toast-hub" id="toastHub" aria-live="polite"></div>

  <!-- Scripts -->
  <script src="database.js?v=5" defer></script>
  <script src="script.js?v=12" defer></script>
</body>
</html>
