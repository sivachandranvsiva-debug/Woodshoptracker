<!DOCTYPE html>
<html lang="ta-IN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta name="theme-color" content="#FF6B00">
  <title>Wood Shop Management | மரக்கடை மேலாண்மை</title>
  <link rel="stylesheet" href="style.css?v=9">
</head>
<body class="app-body">

  <!-- Mobile Drawer Backdrop -->
  <div class="nav-overlay" id="navOverlay" aria-hidden="true"></div>

  <!-- Overall Application Shell -->
  <div class="app-shell">

    <!-- 1. Sidebar Navigation (Desktop Persistent / Mobile Drawer) -->
    <aside class="sidebar-nav" id="sidebarNav" aria-label="Main Navigation">
      <div class="sidebar-header">
        <div class="brand-badge">
          <div class="brand-icon-box">
            <!-- Timber Log Cross Section SVG -->
            <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="18" cy="18" r="16" fill="#FF6B00" />
              <circle cx="18" cy="18" r="11" stroke="#FFFFFF" stroke-width="2" stroke-dasharray="2 2" stroke-opacity="0.8" />
              <circle cx="18" cy="18" r="6" stroke="#FFFFFF" stroke-width="2" stroke-opacity="0.9" />
              <circle cx="18" cy="18" r="2.5" fill="#FFFFFF" />
            </svg>
          </div>
          <div class="brand-text">
            <span class="brand-title">Wood Shop</span>
            <span class="brand-tamil">மரக்கடை மேலாண்மை</span>
          </div>
        </div>

        <button class="close-drawer-btn" id="closeDrawerBtn" aria-label="Close Menu">
          <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Navigation Menu: All 7 Items -->
      <nav class="nav-menu">
        <ul class="nav-list">
          <li class="nav-item">
            <a href="#dashboard" class="nav-link active" data-nav="dashboard">
              <span class="nav-icon orange-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                  <rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
                  <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Dashboard</span>
                <span class="nav-ta">முகப்பு பலகை</span>
              </div>
            </a>
          </li>

          <li class="nav-item">
            <a href="#wood-categories" class="nav-link" data-nav="wood-categories">
              <span class="nav-icon amber-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                  <line x1="12" y1="22.08" x2="12" y2="12"></line>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Wood Categories</span>
                <span class="nav-ta">மர வகைகள்</span>
              </div>
            </a>
          </li>

          <li class="nav-item">
            <a href="#comparison" class="nav-link" data-nav="comparison">
              <span class="nav-icon cyan-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="20" x2="18" y2="10"></line>
                  <line x1="12" y1="20" x2="12" y2="4"></line>
                  <line x1="6" y1="20" x2="6" y2="14"></line>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Buy vs Sell Analysis</span>
                <span class="nav-ta">கொள்முதல் & விற்பனை ஒப்பீடு</span>
              </div>
            </a>
          </li>

          <li class="nav-item">
            <a href="#purchases" class="nav-link" data-nav="purchases">
              <span class="nav-icon rose-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                  <line x1="3" y1="6" x2="21" y2="6"></line>
                  <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Purchases (Buying)</span>
                <span class="nav-ta">கொள்முதல் விவரம்</span>
              </div>
            </a>
          </li>

          <li class="nav-item">
            <a href="#daily-sales" class="nav-link" data-nav="daily-sales">
              <span class="nav-icon green-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="12" y1="1" x2="12" y2="23"></line>
                  <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Sales (Selling)</span>
                <span class="nav-ta">விற்பனை விவரம்</span>
              </div>
            </a>
          </li>

          <li class="nav-item">
            <a href="#expenses" class="nav-link" data-nav="expenses">
              <span class="nav-icon purple-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                  <line x1="2" y1="10" x2="22" y2="10"></line>
                  <circle cx="6" cy="15" r="1"></circle>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Operating Expenses</span>
                <span class="nav-ta">இயக்க செலவுகள்</span>
              </div>
            </a>
          </li>

          <li class="nav-item">
            <a href="#settings" class="nav-link" data-nav="settings">
              <span class="nav-icon slate-icon">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
              </span>
              <div class="nav-label-box">
                <span class="nav-en">Settings</span>
                <span class="nav-ta">அமைப்புகள்</span>
              </div>
            </a>
          </li>
        </ul>
      </nav>

      <!-- Sidebar Bottom Standards Pill -->
      <div class="sidebar-footer-info">
        <div class="info-tag">
          <span class="dot orange-dot"></span>
          <span>அளவு: <strong>கன அடி</strong></span>
        </div>
        <div class="info-tag">
          <span class="dot green-dot"></span>
          <span>நாணயம்: <strong>₹ (ரூபாய்)</strong></span>
        </div>
      </div>
    </aside>

    <!-- Main Workspace Area -->
    <div class="main-wrapper">

      <!-- 2. Header with Shop Name -->
      <header class="app-topbar">
        <div class="topbar-inner">
          <div class="topbar-left">
            <button class="menu-btn" id="menuBtn" aria-label="Open Navigation Menu">
              <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
            </button>

            <div class="shop-identity">
              <div class="shop-heading-group">
                <h1 class="main-app-title">Wood Shop Management</h1>
                <span class="tamil-app-title">மரக்கடை மேலாண்மை</span>
              </div>
              <div class="shop-name-pill" id="shopNamePill">
                <span class="shop-pill-icon">🪵</span>
                <span class="shop-name-text" id="shopNameText">Shop Name / கடை பெயர்</span>
                <button class="shop-name-edit-btn" id="shopNameEditBtn" aria-label="Edit shop name" title="Edit Shop Name">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <div class="topbar-right">
            <div class="offline-ready-badge" title="App works 100% offline via IndexedDB & Service Worker">
              <span class="offline-dot"></span>
              <span>ஆஃப்லைன் தயார்</span>
            </div>
            <div class="standard-badge">
              <span class="badge-cft">கன அடி</span>
              <span class="badge-inr">₹ ரூபாய்</span>
            </div>
          </div>
        </div>
      </header>

      <!-- 3. Dashboard Body -->
      <main class="dashboard-body">

        <!-- ===================================================================
             SECTION A: WOOD CATEGORIES MANAGEMENT (Displayed First!)
             =================================================================== -->
        <section class="dashboard-section section-categories" id="sectionWoodCategories" aria-labelledby="sec-cat-title">
          <div class="section-header">
            <div class="section-title-wrap">
              <h2 id="sec-cat-title" class="section-heading">
                Wood Categories <span class="ta-heading">மர வகைகள்</span>
              </h2>
              <p class="section-sub">Select category to view stock & timber items / வகையைத் தேர்ந்தெடுத்து இருப்பு பார்க்க</p>
            </div>
            <!-- Add New Category Action Button -->
            <button class="btn-action-primary" id="btnOpenAddCategoryModal" aria-label="Add Wood Category">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
              </svg>
              <span>+ Add Category / புதிய வகை</span>
            </button>
          </div>

          <!-- Dynamic Categories Grid (Populated from IndexedDB) -->
          <div class="categories-grid" id="categoriesGrid">
            <!-- Populated dynamically via script.js from IndexedDB 'categories' store -->
          </div>

          <!-- Selected Category Detail & Wood Items Inspector -->
          <div class="category-stock-inspector" id="categoryStockInspector" style="display: none;">
            <div class="inspector-header">
              <div class="inspector-title-group">
                <span class="inspector-badge" id="inspCategoryBadge">Selected Category</span>
                <h3 class="inspector-name" id="inspCategoryName">Category Wood Stock</h3>
                <span class="inspector-stock-pill" id="inspCategoryTotalStock">0.00 கன அடி</span>
              </div>
              <button class="inspector-close-btn" id="btnCloseInspector">&times;</button>
            </div>
            <div class="inspector-body" id="inspectorBody">
              <!-- Itemized breakdown of wood logs, planks, beams in this category -->
            </div>
          </div>
        </section>

        <!-- ===================================================================
             SECTION B: OWNER BUSINESS SUMMARY (All 0 Initially!)
             =================================================================== -->
        <section class="dashboard-section" aria-labelledby="sec-summary-title">
          <div class="section-header">
            <div class="section-title-wrap">
              <h2 id="sec-summary-title" class="section-heading">
                Business Summary <span class="ta-heading">வணிக சுருக்கம்</span>
              </h2>
              <p class="section-sub">Real-time overview &bull; நேரடி வணிக விவரங்கள்</p>
            </div>
          </div>

          <!-- 5 Modern Colourful Animated Summary Cards -->
          <div class="summary-cards-grid five-cards-grid">
            <!-- 1. Total Wood Stock (கன அடி) - Vibrant Amber Theme -->
            <div class="summary-card card-amber">
              <div class="card-top-row">
                <div class="card-icon-bubble bg-amber-bubble">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
                    <line x1="12" y1="22.08" x2="12" y2="12"></line>
                  </svg>
                </div>
                <span class="card-badge badge-amber">Stock / இருப்பு</span>
              </div>
              <div class="card-labels">
                <span class="card-name-en">Total Wood Stock</span>
                <span class="card-name-ta">மொத்த மர இருப்பு</span>
              </div>
              <div class="card-value-wrap">
                <span class="card-value animated-val" id="valTotalStock">0 கன அடி</span>
              </div>
              <span class="card-sub-info" id="valTotalStockSubtitle">0 categories in yard</span>
            </div>

            <!-- 2. Today's Sales (₹) - Vibrant Green Theme -->
            <div class="summary-card card-green">
              <div class="card-top-row">
                <div class="card-icon-bubble bg-green-bubble">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"></line>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                  </svg>
                </div>
                <span class="card-badge badge-green">Today / இன்று</span>
              </div>
              <div class="card-labels">
                <span class="card-name-en">Today's Sales</span>
                <span class="card-name-ta">இன்றைய விற்பனை</span>
              </div>
              <div class="card-value-wrap">
                <span class="card-value animated-val" id="valTodaySales">₹0</span>
              </div>
              <span class="card-sub-info" id="valTodaySalesCount">0 bills generated</span>
            </div>

            <!-- 3. Today's Purchases (₹) - Vibrant Cyan/Blue Theme -->
            <div class="summary-card card-cyan">
              <div class="card-top-row">
                <div class="card-icon-bubble bg-cyan-bubble">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </div>
                <span class="card-badge badge-cyan">Buying / கொள்முதல்</span>
              </div>
              <div class="card-labels">
                <span class="card-name-en">Today's Purchases</span>
                <span class="card-name-ta">இன்றைய கொள்முதல்</span>
              </div>
              <div class="card-value-wrap">
                <span class="card-value animated-val" id="valTodayPurchases">₹0</span>
              </div>
              <span class="card-sub-info" id="valTodayPurchasesCount">0 timber entries</span>
            </div>

            <!-- 4. Total Expenses (₹) - Vibrant Rose Theme -->
            <div class="summary-card card-rose">
              <div class="card-top-row">
                <div class="card-icon-bubble bg-rose-bubble">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                    <line x1="2" y1="10" x2="22" y2="10"></line>
                    <circle cx="6" cy="15" r="1"></circle>
                  </svg>
                </div>
                <span class="card-badge badge-rose">Expenses / செலவு</span>
              </div>
              <div class="card-labels">
                <span class="card-name-en">Total Expenses</span>
                <span class="card-name-ta">மொத்த செலவுகள்</span>
              </div>
              <div class="card-value-wrap">
                <span class="card-value animated-val" id="valTotalExpenses">₹0</span>
              </div>
              <span class="card-sub-info" id="valExpensesSubtitle">Buying, selling & operating</span>
            </div>

            <!-- 5. Net Profit (₹) - Vibrant Purple Theme -->
            <div class="summary-card card-purple">
              <div class="card-top-row">
                <div class="card-icon-bubble bg-purple-bubble">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="8" r="7"></circle>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                  </svg>
                </div>
                <span class="card-badge badge-purple">Profit / லாபம்</span>
              </div>
              <div class="card-labels">
                <span class="card-name-en">Net Profit</span>
                <span class="card-name-ta">நிகர லாபம்</span>
              </div>
              <div class="card-value-wrap">
                <span class="card-value animated-val" id="valNetProfit">₹0</span>
              </div>
              <span class="card-sub-info" id="valNetProfitSubtitle">Calculated with COGS</span>
            </div>
          </div>
        </section>

        <!-- ===================================================================
             SECTION C: BUYING VS SELLING EXPENSE COMPARISON DASHBOARD
             =================================================================== -->
        <section class="dashboard-section section-comparison" id="sectionComparison" aria-labelledby="sec-comp-title">
          <div class="section-header">
            <div class="section-title-wrap">
              <h2 id="sec-comp-title" class="section-heading">
                Buying & Selling Financial Comparison <span class="ta-heading">கொள்முதல் & விற்பனை ஒப்பீடு</span>
              </h2>
              <p class="section-sub">Comprehensive financial analysis: purchase costs, selling revenues & net profit</p>
            </div>
          </div>

          <div class="comparison-dashboard-grid">
            <!-- 1. BUYING / PURCHASE DETAILS CARD -->
            <article class="comparison-card comp-card-buying">
              <div class="comp-card-header bg-cyan-soft">
                <div class="comp-icon-box bg-cyan">
                  <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="comp-card-title">Buying Details / கொள்முதல்</h3>
                  <p class="comp-card-subtitle">Timber Acquisition & Purchasing Costs</p>
                </div>
              </div>
              <div class="comp-metric-list">
                <div class="comp-row">
                  <span class="comp-label">Total Purchase Amount / மொத்த கொள்முதல்:</span>
                  <span class="comp-val text-cyan" id="compTotalPurchases">₹0</span>
                </div>
                <div class="comp-row">
                  <span class="comp-label">Purchasing Expenses / கொள்முதல் செலவுகள்:</span>
                  <span class="comp-val text-rose" id="compBuyingExpenses">₹0</span>
                </div>
                <div class="comp-row">
                  <span class="comp-label">Quantity Purchased / கொள்முதல் அளவு:</span>
                  <span class="comp-val text-bold" id="compTotalPurchasedVolume">0 கன அடி</span>
                </div>
                <div class="comp-row">
                  <span class="comp-label">Avg. Purchase Price / சராசரி கொள்முதல் விலை:</span>
                  <span class="comp-val" id="compAvgPurchaseRate">₹0 / கன அடி</span>
                </div>
                <div class="comp-row">
                  <span class="comp-label">Suppliers / மர விற்பனையாளர்கள்:</span>
